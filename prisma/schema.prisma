generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(40)
  message   String   @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("entries")
}
